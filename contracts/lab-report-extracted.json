{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "lab-report-extracted",
  "type": "object",
  "required": ["document_id", "tenant", "type", "patient_ref", "collected_on"],
  "properties": {
    "document_id": { "type": "string", "pattern": "^doc_[0-9a-f]{32}$" },
    "tenant": { "type": "string", "maxLength": 64 },
    "type": { "const": "lab-report" },
    "patient_ref": { "type": "string", "maxLength": 64 },
    "collected_on": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "test_code": { "type": ["string", "null"], "maxLength": 32 }
  }
}
